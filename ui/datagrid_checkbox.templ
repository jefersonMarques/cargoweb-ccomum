package ui

templ DataGridCheckboxCell(columnKey string, name string, value string, label string, checked bool, disabled bool) {
	@DataGridCell(columnKey) {
		<label class="group inline-flex size-8 cursor-pointer items-center justify-center" title={ label }>
			@CheckboxControl(name, value, label, checked, disabled)
			<span class="sr-only">{ label }</span>
		</label>
	}
}
