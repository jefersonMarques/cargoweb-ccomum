package ui

templ StatusLabel(label string, tone string) {
	if tone == "success" {
		<span class="inline-flex border border-emerald-700/20 bg-emerald-50 px-2 py-1 text-[9px] font-extrabold uppercase tracking-[0.08em] text-emerald-800 dark:border-emerald-500/30 dark:bg-emerald-950/40 dark:text-emerald-300">{ label }</span>
	} else if tone == "accent" {
		<span class="inline-flex border border-brand-orange/25 bg-brand-orange/10 px-2 py-1 text-[9px] font-extrabold uppercase tracking-[0.08em] text-brand-orange">{ label }</span>
	} else {
		<span class="inline-flex border border-brand-line bg-brand-bg px-2 py-1 text-[9px] font-extrabold uppercase tracking-[0.08em] text-brand-muted dark:border-brand-dark-line dark:bg-brand-sidebar-soft dark:text-brand-dark-muted">{ label }</span>
	}
}
