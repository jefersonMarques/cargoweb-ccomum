package ui

import (
	"strconv"

	"github.com/dimmerz92/go-icons/lucide"
	"github.com/jefersonMarques/cargoweb-ccomum/datagrid"
)

templ DataGrid(definition datagrid.Definition, state datagrid.State, pagination datagrid.Pagination, action string, searchPlaceholder string, searchEnabled bool) {
	<div class="grid gap-3" data-grid data-grid-key={ definition.Key }>
		<div class="flex flex-col gap-3 border border-brand-line bg-brand-surface p-3 sm:flex-row sm:items-end sm:justify-between dark:border-brand-dark-line dark:bg-brand-dark-surface">
			if searchEnabled {
				<form class="flex min-w-0 flex-1 gap-2" method="get" action={ action } { moduleGetFormAttributes(action)... }>
					if state.Sort != "" {
						<input type="hidden" name="sort" value={ state.Sort }/>
						<input type="hidden" name="dir" value={ string(state.Direction) }/>
					}
					if state.PageSize > 0 {
						<input type="hidden" name="page_size" value={ strconv.Itoa(state.PageSize) }/>
					}
					for key, value := range state.Filters {
						<input type="hidden" name={ "f_" + key } value={ value }/>
					}
					<input class="h-10 min-w-0 flex-1 border border-brand-line bg-brand-surface px-3 text-xs text-brand-ink outline-none transition placeholder:text-brand-muted/70 focus:border-brand-orange focus:ring-1 focus:ring-brand-orange dark:border-brand-dark-line dark:bg-brand-deep dark:text-white" type="search" name="q" value={ state.Search } minlength="2" maxlength="120" autocomplete="off" placeholder={ searchPlaceholder }/>
					<button class="h-10 border border-brand-line px-3 text-[10px] font-extrabold uppercase tracking-[0.08em] text-brand-ink transition hover:border-brand-orange hover:text-brand-orange dark:border-brand-dark-line dark:text-slate-100" type="submit">Pesquisar</button>
					if state.Search != "" || state.HasActiveFilters() || state.Sort != "" {
						<a class="grid h-10 place-items-center border border-brand-line px-3 text-[10px] font-extrabold uppercase tracking-[0.08em] text-brand-muted transition hover:border-brand-orange hover:text-brand-orange dark:border-brand-dark-line dark:text-brand-dark-muted" href={ action } { moduleNavigationAttributes(action)... }>Limpar</a>
					}
				</form>
			}
			<details class="relative shrink-0" data-grid-columns-menu>
				<summary class="flex h-10 cursor-pointer list-none items-center gap-2 border border-brand-line px-3 text-[10px] font-extrabold uppercase tracking-[0.08em] text-brand-ink marker:content-none hover:border-brand-orange dark:border-brand-dark-line dark:text-slate-100">
					@lucide.Columns3(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.7", "aria-hidden": "true"})
					<span>Colunas</span>
				</summary>
				<div class="absolute right-0 top-[calc(100%+6px)] z-50 w-80 border border-brand-line bg-brand-surface p-2 shadow-lg dark:border-brand-dark-line dark:bg-brand-dark-surface">
					<div class="px-2 pb-2 pt-1">
						<p class="text-[9px] font-extrabold uppercase tracking-[0.1em] text-brand-muted dark:text-brand-dark-muted">Exibição e ordem</p>
					</div>
					<div class="grid" data-grid-columns-list>
						for _, column := range definition.Columns {
							if column.Hideable || column.Reorderable {
								<div class="flex min-h-11 items-center gap-3 border-t border-brand-line px-2 py-2 first:border-t-0 dark:border-brand-dark-line" data-grid-column-item={ column.Key }>
									<div class="min-w-0 flex-1">
										<span class="block truncate text-xs font-semibold text-brand-ink dark:text-slate-100">{ column.Label }</span>
									</div>
									if column.Hideable {
										<label class="relative inline-flex shrink-0 cursor-pointer items-center" aria-label={ "Exibir coluna " + column.Label }>
											<input class="peer sr-only" type="checkbox" checked data-grid-column-toggle={ column.Key }/>
											<span class="relative h-5 w-9 border border-brand-line bg-brand-line transition peer-checked:border-brand-orange peer-checked:bg-brand-orange peer-checked:[&>span]:translate-x-4 dark:border-brand-dark-line dark:bg-brand-dark-line dark:peer-checked:border-brand-orange dark:peer-checked:bg-brand-orange">
												<span class="absolute left-[2px] top-[2px] size-[14px] bg-white transition-transform"></span>
											</span>
										</label>
									}
									if column.Reorderable {
										<div class="flex shrink-0 border border-brand-line dark:border-brand-dark-line">
											<button class="grid size-8 place-items-center text-brand-muted transition hover:bg-brand-bg hover:text-brand-orange disabled:cursor-not-allowed disabled:opacity-30 dark:text-brand-dark-muted dark:hover:bg-brand-sidebar-soft" type="button" data-grid-move="up" data-grid-column-key={ column.Key } aria-label={ "Mover " + column.Label + " para cima" }>
												@lucide.ChevronUp(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8", "aria-hidden": "true"})
											</button>
											<button class="grid size-8 place-items-center border-l border-brand-line text-brand-muted transition hover:bg-brand-bg hover:text-brand-orange disabled:cursor-not-allowed disabled:opacity-30 dark:border-brand-dark-line dark:text-brand-dark-muted dark:hover:bg-brand-sidebar-soft" type="button" data-grid-move="down" data-grid-column-key={ column.Key } aria-label={ "Mover " + column.Label + " para baixo" }>
												@lucide.ChevronDown(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8", "aria-hidden": "true"})
											</button>
										</div>
									}
								</div>
							}
						}
					</div>
				</div>
			</details>
		</div>
		<div class="relative overflow-visible border border-brand-line bg-brand-surface dark:border-brand-dark-line dark:bg-brand-dark-surface">
			<table class="w-full min-w-[760px] border-collapse text-left">
				<thead class="border-b border-brand-line bg-brand-bg dark:border-brand-dark-line dark:bg-brand-sidebar-soft">
					<tr data-grid-header-row>
						for _, column := range definition.Columns {
							@DataGridHeaderCell(column, state, action)
						}
						<th class="w-12 px-2 py-3 text-center text-[9px] font-extrabold uppercase tracking-[0.1em] text-brand-muted dark:text-brand-dark-muted" scope="col" data-grid-actions-header>
							<span class="sr-only">Ações</span>
							@lucide.EllipsisVertical(templ.Attributes{"width": "15", "height": "15", "stroke-width": "1.7", "aria-hidden": "true"})
						</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-brand-line dark:divide-brand-dark-line">
					{ children... }
				</tbody>
			</table>
		</div>
		if definition.Paginated {
			@DataGridPagination(definition, state, pagination, action)
		}
	</div>
}

templ DataGridHeaderCell(column datagrid.Column, state datagrid.State, action string) {
	<th class="relative px-4 py-3 text-[9px] font-extrabold uppercase tracking-[0.1em] text-brand-muted dark:text-brand-dark-muted" scope="col" data-grid-header={ column.Key }>
		<div class="flex items-center gap-2">
			<span>{ column.Label }</span>
			if state.Sort == column.Key {
				if state.Direction == datagrid.DirectionDescending {
					@lucide.ArrowDown(templ.Attributes{"width": "12", "height": "12", "stroke-width": "1.8", "aria-hidden": "true"})
				} else {
					@lucide.ArrowUp(templ.Attributes{"width": "12", "height": "12", "stroke-width": "1.8", "aria-hidden": "true"})
				}
			}
			if state.HasFilter(column.Key) {
				<span class="size-1.5 bg-brand-orange" aria-label="Coluna filtrada"></span>
			}
			if column.Sortable || column.Filterable {
				<details class="relative ml-auto" data-grid-column-menu>
					<summary class="grid size-7 cursor-pointer list-none place-items-center text-brand-muted marker:content-none hover:bg-brand-surface hover:text-brand-orange dark:text-brand-dark-muted dark:hover:bg-brand-deep" aria-label={ "Opções da coluna " + column.Label }>
						@lucide.EllipsisVertical(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8", "aria-hidden": "true"})
					</summary>
					<div class="absolute right-0 top-[calc(100%+4px)] z-50 w-64 border border-brand-line bg-brand-surface p-2 text-left normal-case tracking-normal shadow-lg dark:border-brand-dark-line dark:bg-brand-dark-surface">
						if column.Sortable {
							<a class="flex items-center gap-2 px-2 py-2 text-xs font-medium text-brand-ink hover:bg-brand-bg dark:text-slate-100 dark:hover:bg-brand-sidebar-soft" href={ dataGridURL(action, state, column.Key, datagrid.DirectionAscending, "") } { moduleNavigationAttributes(dataGridURL(action, state, column.Key, datagrid.DirectionAscending, ""))... } data-grid-sort-direction="asc">
								@lucide.ArrowUp(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.7", "aria-hidden": "true"})
								<span>Ordenar crescente</span>
							</a>
							<a class="flex items-center gap-2 px-2 py-2 text-xs font-medium text-brand-ink hover:bg-brand-bg dark:text-slate-100 dark:hover:bg-brand-sidebar-soft" href={ dataGridURL(action, state, column.Key, datagrid.DirectionDescending, "") } { moduleNavigationAttributes(dataGridURL(action, state, column.Key, datagrid.DirectionDescending, ""))... } data-grid-sort-direction="desc">
								@lucide.ArrowDown(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.7", "aria-hidden": "true"})
								<span>Ordenar decrescente</span>
							</a>
						}
						if column.Filterable {
							if column.Sortable {
								<div class="my-2 border-t border-brand-line dark:border-brand-dark-line"></div>
							}
							<form class="grid gap-2 px-2 py-1" method="get" action={ action } { moduleGetFormAttributes(action)... }>
								if state.Search != "" {
									<input type="hidden" name="q" value={ state.Search }/>
								}
								if state.Sort != "" {
									<input type="hidden" name="sort" value={ state.Sort }/>
									<input type="hidden" name="dir" value={ string(state.Direction) }/>
								}
								if state.PageSize > 0 {
									<input type="hidden" name="page_size" value={ strconv.Itoa(state.PageSize) }/>
								}
								for key, value := range state.Filters {
									if key != column.Key {
										<input type="hidden" name={ "f_" + key } value={ value }/>
									}
								}
								<label class="grid gap-1 text-[10px] font-bold uppercase tracking-[0.06em] text-brand-muted dark:text-brand-dark-muted">
									<span>Filtrar</span>
									if column.Filter == datagrid.FilterSelect {
										<select class="h-9 border border-brand-line bg-brand-surface px-2 text-xs font-medium normal-case text-brand-ink outline-none focus:border-brand-orange dark:border-brand-dark-line dark:bg-brand-deep dark:text-white" name={ "f_" + column.Key }>
											<option value="">Todos</option>
											for _, option := range column.Options {
												if state.FilterValue(column.Key) == option.Value {
													<option value={ option.Value } selected>{ option.Label }</option>
												} else {
													<option value={ option.Value }>{ option.Label }</option>
												}
											}
										</select>
									} else {
										<input class="h-9 border border-brand-line bg-brand-surface px-2 text-xs font-medium normal-case text-brand-ink outline-none placeholder:text-brand-muted/70 focus:border-brand-orange dark:border-brand-dark-line dark:bg-brand-deep dark:text-white" type="search" name={ "f_" + column.Key } value={ state.FilterValue(column.Key) } maxlength="120" autocomplete="off" placeholder="Contém..."/>
									}
								</label>
								<div class="flex gap-2">
									<button class="h-8 flex-1 bg-brand-orange px-2 text-[10px] font-extrabold uppercase tracking-[0.06em] text-white hover:bg-brand-orange-hover" type="submit">Aplicar</button>
									if state.HasFilter(column.Key) {
										<a class="grid h-8 place-items-center border border-brand-line px-2 text-[10px] font-extrabold uppercase tracking-[0.06em] text-brand-muted hover:border-brand-orange hover:text-brand-orange dark:border-brand-dark-line dark:text-brand-dark-muted" href={ dataGridURL(action, state, "", state.Direction, column.Key) } { moduleNavigationAttributes(dataGridURL(action, state, "", state.Direction, column.Key))... }>Limpar</a>
									}
								</div>
							</form>
						}
					</div>
				</details>
			}
		</div>
	</th>
}

templ DataGridRow() {
	<tr class="transition hover:bg-brand-bg/70 dark:hover:bg-brand-sidebar-soft/70" data-grid-row>
		{ children... }
	</tr>
}

templ DataGridCell(key string) {
	<td class="px-4 py-3 align-middle text-xs text-brand-ink dark:text-slate-100" data-grid-cell={ key }>
		{ children... }
	</td>
}

templ DataGridActionsCell(actions []DataGridAction) {
	<td class="w-12 px-2 py-2 text-center align-middle" data-grid-actions-cell>
		<details class="relative inline-block text-left" data-grid-row-menu>
			<summary class="grid size-8 cursor-pointer list-none place-items-center text-brand-muted marker:content-none hover:bg-brand-bg hover:text-brand-orange dark:text-brand-dark-muted dark:hover:bg-brand-sidebar-soft" aria-label="Ações">
				@lucide.EllipsisVertical(templ.Attributes{"width": "16", "height": "16", "stroke-width": "1.8", "aria-hidden": "true"})
			</summary>
			<div class="absolute right-0 top-[calc(100%+4px)] z-50 min-w-48 border border-brand-line bg-brand-surface p-1 shadow-lg dark:border-brand-dark-line dark:bg-brand-dark-surface">
				for _, action := range actions {
					if action.Method == "POST" {
						<form method="post" action={ action.Href }>
							<input type="hidden" name="csrf_token" value={ action.CSRFToken }/>
							if action.Destructive {
								<button class="flex w-full items-center gap-2 px-3 py-2 text-left text-xs font-medium text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/30" type="submit">
									if action.Icon != nil {
										@renderIcon(action.Icon, templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8", "aria-hidden": "true"})
									}
									<span>{ action.Label }</span>
								</button>
							} else {
								<button class="flex w-full items-center gap-2 px-3 py-2 text-left text-xs font-medium text-brand-ink hover:bg-brand-bg dark:text-slate-100 dark:hover:bg-brand-sidebar-soft" type="submit">
									if action.Icon != nil {
										@renderIcon(action.Icon, templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8", "aria-hidden": "true"})
									}
									<span>{ action.Label }</span>
								</button>
							}
						</form>
					} else {
						<a class="flex items-center gap-2 px-3 py-2 text-xs font-medium text-brand-ink hover:bg-brand-bg dark:text-slate-100 dark:hover:bg-brand-sidebar-soft" href={ action.Href } { moduleNavigationAttributes(action.Href)... }>
							if action.Icon != nil {
								@renderIcon(action.Icon, templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8", "aria-hidden": "true"})
							}
							<span>{ action.Label }</span>
						</a>
					}
				}
			</div>
		</details>
	</td>
}

templ DataGridPagination(definition datagrid.Definition, state datagrid.State, pagination datagrid.Pagination, action string) {
	<div class="flex flex-col gap-3 border border-brand-line bg-brand-surface px-3 py-3 sm:flex-row sm:items-center sm:justify-between dark:border-brand-dark-line dark:bg-brand-dark-surface">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[10px] font-semibold text-brand-muted dark:text-brand-dark-muted">
			<span><strong class="text-brand-ink dark:text-slate-100">{ strconv.Itoa(pagination.FirstItem()) }–{ strconv.Itoa(pagination.LastItem()) }</strong> de { strconv.Itoa(pagination.Total) }</span>
			<form class="flex items-center gap-2" method="get" action={ action } data-grid-page-size-form { moduleGetFormAttributes(action)... }>
				if state.Search != "" {
					<input type="hidden" name="q" value={ state.Search }/>
				}
				if state.Sort != "" {
					<input type="hidden" name="sort" value={ state.Sort }/>
					<input type="hidden" name="dir" value={ string(state.Direction) }/>
				}
				for key, value := range state.Filters {
					<input type="hidden" name={ "f_" + key } value={ value }/>
				}
				<label class="flex items-center gap-2">
					<span>Itens por página</span>
					<select class="h-8 border border-brand-line bg-brand-surface px-2 text-xs font-semibold text-brand-ink outline-none focus:border-brand-orange dark:border-brand-dark-line dark:bg-brand-deep dark:text-white" name="page_size" data-grid-page-size>
						for _, size := range definition.PageSizeOptions() {
							if state.PageSize == size {
								<option value={ strconv.Itoa(size) } selected>{ strconv.Itoa(size) }</option>
							} else {
								<option value={ strconv.Itoa(size) }>{ strconv.Itoa(size) }</option>
							}
						}
					</select>
				</label>
				<button class="h-8 border border-brand-line px-2 text-[9px] font-extrabold uppercase tracking-[0.06em] text-brand-muted hover:border-brand-orange hover:text-brand-orange dark:border-brand-dark-line dark:text-brand-dark-muted" type="submit">Aplicar</button>
			</form>
		</div>
		<div class="flex items-center gap-2">
			if pagination.HasPrevious() {
				<a class="grid size-8 place-items-center border border-brand-line text-brand-muted hover:border-brand-orange hover:text-brand-orange dark:border-brand-dark-line dark:text-brand-dark-muted" href={ dataGridPageURL(action, state, pagination.PreviousPage()) } { moduleNavigationAttributes(dataGridPageURL(action, state, pagination.PreviousPage()))... } aria-label="Página anterior">
					@lucide.ChevronLeft(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8", "aria-hidden": "true"})
				</a>
			} else {
				<span class="grid size-8 place-items-center border border-brand-line text-brand-muted opacity-30 dark:border-brand-dark-line dark:text-brand-dark-muted" aria-hidden="true">
					@lucide.ChevronLeft(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8"})
				</span>
			}
			<span class="min-w-24 text-center text-[10px] font-semibold text-brand-muted dark:text-brand-dark-muted">Página <strong class="text-brand-ink dark:text-slate-100">{ strconv.Itoa(pagination.Page) }</strong> de { strconv.Itoa(pagination.PageCount()) }</span>
			if pagination.HasNext() {
				<a class="grid size-8 place-items-center border border-brand-line text-brand-muted hover:border-brand-orange hover:text-brand-orange dark:border-brand-dark-line dark:text-brand-dark-muted" href={ dataGridPageURL(action, state, pagination.NextPage()) } { moduleNavigationAttributes(dataGridPageURL(action, state, pagination.NextPage()))... } aria-label="Próxima página">
					@lucide.ChevronRight(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8", "aria-hidden": "true"})
				</a>
			} else {
				<span class="grid size-8 place-items-center border border-brand-line text-brand-muted opacity-30 dark:border-brand-dark-line dark:text-brand-dark-muted" aria-hidden="true">
					@lucide.ChevronRight(templ.Attributes{"width": "14", "height": "14", "stroke-width": "1.8"})
				</span>
			}
		</div>
	</div>
}
